# Token que o SysMG envia no header "Authorization: Bearer <token>".
# Gere com: openssl rand -hex 32
OCR_API_TOKEN=

# Subdominio apontado para o IP da VPS (registro A no DNS)
OCR_DOMAIN=ocr.seudominio.com.br

# Processamentos simultaneos (1 por vCPU)
GUNICORN_WORKERS=2

# Tamanho maximo do PDF enviado
MAX_UPLOAD_MB=200
